# syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e
# check=error=true

ARG BASE_IMAGE=ubuntu:26.04

FROM ${BASE_IMAGE} AS source
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends gpgv \
 && rm -rf /var/lib/apt/lists/*
ARG VERSION
ARG SOURCE_SHA256
ADD --checksum=sha256:${SOURCE_SHA256} https://github.com/sleuthkit/sleuthkit/releases/download/sleuthkit-${VERSION}/sleuthkit-${VERSION}.tar.gz /src/
ADD https://github.com/sleuthkit/sleuthkit/releases/download/sleuthkit-${VERSION}/sleuthkit-${VERSION}.tar.gz.asc /src/
ARG TSK_LVM_HEADER_VERSION
ARG TSK_LVM_HEADER_SHA256
ADD --checksum=sha256:${TSK_LVM_HEADER_SHA256} https://raw.githubusercontent.com/sleuthkit/sleuthkit/sleuthkit-${TSK_LVM_HEADER_VERSION}/tsk/pool/tsk_lvm.hpp /src/
# Brian Carrier's release signing key, fingerprint 0917 A7EE 58A9 308B 13D3 9633 38AD 602E C745 4C8B,
# a DSA-1024 key from 2004 without expiry date that signs with SHA-1. A release
# signed with any other key fails here until that key is added to
# keys/sleuthkit-release.gpg.
COPY keys/sleuthkit-release.gpg /tmp/sleuthkit-release.gpg
WORKDIR /src
# The release tarballs leave out tsk/pool/tsk_lvm.hpp, which the LVM support
# includes, so it is taken from the release tag (tsk-lvm-header in
# package.yml). A tarball that has its own copy must match it.
RUN set -eu; \
    gpgv --keyring /tmp/sleuthkit-release.gpg "sleuthkit-${VERSION}.tar.gz.asc" "sleuthkit-${VERSION}.tar.gz"; \
    mkdir sleuthkit; \
    tar -xzf "sleuthkit-${VERSION}.tar.gz" -C sleuthkit --strip-components=1; \
    if [ -e sleuthkit/tsk/pool/tsk_lvm.hpp ]; then \
      cmp tsk_lvm.hpp sleuthkit/tsk/pool/tsk_lvm.hpp \
        || { echo "sleuthkit-${VERSION}.tar.gz has its own tsk_lvm.hpp, which differs from tsk-lvm-header" >&2; exit 1; }; \
    else \
      cp tsk_lvm.hpp sleuthkit/tsk/pool/tsk_lvm.hpp; \
    fi

FROM ${BASE_IMAGE} AS build
ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
# The base image's packages are recorded before anything is installed, so that
# runtime-deps can leave them out. Every image that installs runtime-deps is
# built on the same base.
RUN dpkg-query -W -f '${Package}\n' | LC_ALL=C sort -u > /tmp/base-packages; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      build-essential \
      libafflib-dev \
      libbfio-dev \
      libewf-dev \
      libsqlite3-dev \
      libvhdi-dev \
      libvmdk-dev \
      libvslvm-dev \
      zlib1g-dev; \
    rm -rf /var/lib/apt/lists/*
COPY --link --from=source /src/sleuthkit /src/sleuthkit
WORKDIR /src/sleuthkit
ARG JOBS
ARG VERSION
# configure leaves out an image format library, or uses the SQLite copy in the
# tarball, without failing, so its summary is checked. libtsk is built as a
# shared library only, so the tools load one copy of it from /usr/local/lib
# instead of each linking it in. GCC 15 compiles C as C23 by default, in which
# true and false are keywords that tsk_unicode.c defines as macros. The
# Java bindings are not built. jpeg_extract, a fiwalk plugin that runs the
# exif program, is removed, since the image has no exif.
# Ubuntu builds libvslvm with its own copy of libbfio, which it exports and
# whose pool structure differs from the distro's older libbfio. libtsk creates
# the libbfio handle and pool that it passes to libvslvm, so its libbfio calls
# must bind to that copy: libvslvm has to be the first library libtsk loads
# that defines them. libbfio-dev is only there for its headers and the
# configure check.
RUN printf '%s\n' "${VERSION}" | grep -Eqx '[0-9]+\.[0-9]+\.[0-9]+' \
      || { echo "unexpected VERSION: ${VERSION}" >&2; exit 1; }; \
    ./configure \
      --prefix=/usr/local \
      --disable-static \
      --disable-java \
      --disable-cppunit \
      PERL=/usr/bin/perl \
      CFLAGS='-O2 -std=gnu17' \
      | tee /tmp/configure.log; \
    for want in 'afflib support: yes' 'libewf support: yes' 'zlib support: yes' 'fiwalk support: yes' \
      'libbfio support: yes' 'libvhdi support: yes' 'libvmdk support: yes' 'libvslvm support: yes' \
      'Java/JNI support: no' 'Multithreading: yes'; do \
      grep -Eq "^ +${want%%: *}: +${want#*: }\$" /tmp/configure.log \
        || { echo "configure did not report ${want}" >&2; exit 1; }; \
    done; \
    grep -Fqx 'checking which sqlite3 to use... system' /tmp/configure.log \
      || { echo "configure chose the bundled SQLite" >&2; exit 1; }; \
    make -j"${JOBS:-$(nproc)}"; \
    make install-strip DESTDIR=/out; \
    rm -rf /out/usr/local/include /out/usr/local/lib/pkgconfig /out/usr/local/share/man; \
    rm -f /out/usr/local/lib/libtsk.la /out/usr/local/lib/libtsk.so /out/usr/local/bin/jpeg_extract; \
    printf '%s\n' blkcalc blkcat blkls blkstat fcat ffind fiwalk fls fsstat hfind icat ifind ils img_cat \
      img_stat istat jcat jls mactime mmcat mmls mmstat pstat sigfind sorter srch_strings tsk_comparedir \
      tsk_gettimes tsk_imageinfo tsk_loaddb tsk_recover usnjls > /tmp/tools.expected; \
    find /out/usr/local/bin -mindepth 1 -printf '%f\n' | LC_ALL=C sort > /tmp/tools; \
    if ! cmp -s /tmp/tools.expected /tmp/tools; then \
      echo "the install does not have the expected programs:" >&2; \
      diff /tmp/tools.expected /tmp/tools >&2 || true; \
      exit 1; \
    fi; \
    for s in mactime sorter; do \
      test "$(head -n 1 "/out/usr/local/bin/$s")" = '#!/usr/bin/perl -w' \
        || { echo "$s does not start with #!/usr/bin/perl -w" >&2; exit 1; }; \
    done; \
    lib="$(find /out/usr/local/lib -name 'libtsk.so.*' -type f)"; \
    readelf -d "$lib" | sed -n 's/.*(NEEDED).*\[\(.*\)\]$/\1/p' > /tmp/libtsk-needed; \
    for so in libafflib libewf libsqlite3 libvhdi libvmdk libvslvm libz; do \
      grep -q "^${so}\.so\." /tmp/libtsk-needed || { echo "libtsk does not load ${so}" >&2; exit 1; }; \
    done; \
    nm -D --undefined-only "$lib" | awk '$2 ~ /^libbfio_/ { print $2 }' | LC_ALL=C sort > /tmp/libtsk-bfio; \
    test -s /tmp/libtsk-bfio || { echo "libtsk calls no libbfio function" >&2; exit 1; }; \
    ldd "$lib" | awk '$2 == "=>" && $3 ~ /^\// { print $3 }' > /tmp/libtsk-deps; \
    bfio=; \
    while read -r so; do \
      nm -D --defined-only "$so" | awk '$3 ~ /^libbfio_/ { print $3 }' | LC_ALL=C sort > /tmp/bfio-defined; \
      if [ -s /tmp/bfio-defined ]; then bfio="$so"; break; fi; \
    done < /tmp/libtsk-deps; \
    case "$bfio" in \
      */libvslvm.so.*) ;; \
      *) echo "libtsk binds its libbfio calls to ${bfio:-no library}, not to libvslvm" >&2; exit 1 ;; \
    esac; \
    LC_ALL=C comm -23 /tmp/libtsk-bfio /tmp/bfio-defined > /tmp/bfio-missing; \
    if [ -s /tmp/bfio-missing ]; then \
      echo "libvslvm does not define these libbfio functions that libtsk calls:" >&2; \
      cat /tmp/bfio-missing >&2; \
      exit 1; \
    fi; \
    export LD_LIBRARY_PATH=/out/usr/local/lib; \
    test "$(/out/usr/local/bin/fls -V)" = "The Sleuth Kit ver ${VERSION}" \
      || { echo "fls -V does not print The Sleuth Kit ver ${VERSION}" >&2; exit 1; }; \
    /out/usr/local/bin/fiwalk -V > /tmp/fiwalk-version; \
    /out/usr/local/bin/img_stat -i list 2> /tmp/image-types || true; \
    grep -Eq '^LIBEWF Version: +2014[0-9]{4}$' /tmp/fiwalk-version \
      || { cat /tmp/fiwalk-version >&2; exit 1; }

ARG BASE_IMAGE
ARG SOURCE_SHA256
ARG TSK_LVM_HEADER_VERSION
ARG TSK_LVM_HEADER_SHA256
# runtime-deps lists the packages that own the libraries the programs load,
# minus the base image's packages, plus the packages in runtime-deps.ubuntu:
# Perl for mactime and sorter, file for sorter, and the time zone data that
# mactime -z reads.
RUN --mount=type=bind,source=runtime-deps.ubuntu,target=/tmp/runtime-deps.extra \
    set -eu; \
    meta=/out/usr/local/share/randomcontainers/sleuthkit; \
    mkdir -p "$meta/licenses"; \
    cp licenses/README.md licenses/cpl1.0.txt licenses/IBM-LICENSE licenses/GNUv2-COPYING \
      licenses/bsd.txt licenses/mit.txt "$meta/licenses/"; \
    notice() { awk -v m="$2" '/\/\*/ { c = 1; b = "" } c { b = b $0 "\n" } c && /\*\// { c = 0; if (index(b, m)) printf "%s", b }' "$1"; }; \
    notice tsk/base/md5c.c 'License to copy and use' > "$meta/licenses/COPYING.md5c"; \
    notice tsk/base/tsk_unicode.c 'Limitations on Rights to Redistribute' > "$meta/licenses/COPYING.tsk_unicode"; \
    notice tsk/fs/lzvn.c 'Redistribution and use' > "$meta/licenses/COPYING.lzvn"; \
    notice tsk/auto/guid.cpp 'Permission is hereby granted' > "$meta/licenses/COPYING.guid"; \
    notice tools/fiwalk/src/sha2.c 'Redistribution and use' > "$meta/licenses/COPYING.sha2"; \
    notice tools/fiwalk/src/base64.cpp 'Copyright (c)' > "$meta/licenses/COPYING.base64"; \
    awk 'NR == 1, /ADVISED OF THE POSSIBILITY OF SUCH DAMAGE/' tools/timeline/mactime.base > "$meta/licenses/COPYING.mactime"; \
    for f in md5c:'RSA Data Security' tsk_unicode:'Unicode, Inc.' lzvn:'Apple Inc.' guid:'Graeme Hill' \
      sha2:'Olivier Gay' base64:'International Business Machines' mactime:'Dan Farmer'; do \
      grep -Fq "${f#*:}" "$meta/licenses/COPYING.${f%%:*}" \
        || { echo "COPYING.${f%%:*} lacks ${f#*:}" >&2; exit 1; }; \
    done; \
    for f in "$meta"/licenses/*; do test -s "$f"; done; \
    echo "${VERSION}" > "$meta/version"; \
    printf '%s\n' \
      "https://github.com/sleuthkit/sleuthkit/releases/download/sleuthkit-${VERSION}/sleuthkit-${VERSION}.tar.gz" \
      "https://github.com/sleuthkit/sleuthkit/releases/download/sleuthkit-${VERSION}/sleuthkit-${VERSION}.tar.gz.asc" \
      "https://raw.githubusercontent.com/sleuthkit/sleuthkit/sleuthkit-${TSK_LVM_HEADER_VERSION}/tsk/pool/tsk_lvm.hpp" \
      "https://github.com/randomcontainers/sleuthkit/releases/tag/v${VERSION}" \
      > "$meta/source"; \
    { \
      echo "base: ${BASE_IMAGE}"; \
      echo "source-sha256: ${SOURCE_SHA256}"; \
      echo "tsk-lvm-header: ${TSK_LVM_HEADER_VERSION}"; \
      echo "tsk-lvm-header-sha256: ${TSK_LVM_HEADER_SHA256}"; \
      echo "compiler: $(c++ --version | head -n 1)"; \
      echo "configure: $(sed -n 's/^  \$ \.\/configure //p' config.log)"; \
      sed -n '/^Building:/,/Multithreading:/p' /tmp/configure.log; \
      cat /tmp/fiwalk-version /tmp/image-types; \
    } > "$meta/buildinfo"; \
    find /out/usr/local -type f \( -perm -u+x -o -name '*.so*' \) -print0 \
      | xargs -0 env LD_LIBRARY_PATH=/out/usr/local/lib ldd > /tmp/ldd 2>&1 || true; \
    if grep 'not found' /tmp/ldd; then exit 1; fi; \
    awk '$2 == "=>" && $3 ~ /^\// && $3 !~ /^\/out\// { print $3 }' /tmp/ldd | LC_ALL=C sort -u > /tmp/libs; \
    test -s /tmp/libs; \
    while read -r lib; do \
      real="$(readlink -f "$lib")"; \
      dpkg-query --search "*${real#/usr}"; \
    done < /tmp/libs | cut -d: -f1 | LC_ALL=C sort -u | LC_ALL=C comm -23 - /tmp/base-packages > /tmp/elf-deps; \
    LC_ALL=C sort -u /tmp/elf-deps /tmp/runtime-deps.extra > "$meta/runtime-deps"

FROM ${BASE_IMAGE} AS slim
ARG DEBIAN_FRONTEND=noninteractive
RUN --mount=type=bind,from=build,source=/out/usr/local/share/randomcontainers/sleuthkit/runtime-deps,target=/tmp/runtime-deps \
    set -eu; \
    apt-get update; \
    xargs apt-get install -y --no-install-recommends ca-certificates tini < /tmp/runtime-deps; \
    rm -rf /var/lib/apt/lists/*; \
    install -d -m 1777 /work /cache
COPY --link --from=build /out/usr/local/ /usr/local/
# libtsk is in /usr/local/lib, which the loader searches only through the
# cache that ldconfig writes.
RUN ldconfig
ENV LANG=C.UTF-8 XDG_CACHE_HOME=/cache
WORKDIR /work
USER 1000:1000
ENTRYPOINT ["tini", "--", "fls"]
CMD ["-V"]
